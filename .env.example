# Copy to .env.local and fill in. Never commit .env.local.

# ---- Chain ----------------------------------------------------------------
# Local surfnet by default. Pointing at live mainnet is a change here only.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
HELIUS_API_KEY=

# Collateral asset. Run `pnpm probe` against a running surfnet to see which
# tokenized stocks Kamino currently lends against, then paste the mint here.
NEXT_PUBLIC_XSTOCK_MINT=
NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ---- Fee payer ------------------------------------------------------------
# Sponsors network fees so users never hold SOL. Server only — this key must
# never reach the browser, and never a NEXT_PUBLIC_ variable.
FEE_PAYER_SECRET_KEY=

# ---- Privy ----------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- Convex ---------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=

# ---- Risk policy ----------------------------------------------------------
# Deliberately well below whatever the protocol allows. See packages/core/src/policy.ts
DRAW_MAX_LTV=0.35
DRAW_WARN_HEALTH_FACTOR=1.6
