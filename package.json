{
  "name": "draw",
  "version": "0.1.0",
  "private": true,
  "description": "Spend against what you own — portfolio-backed payments on Solana",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @draw/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "chain": "pnpm --filter @draw/scripts chain",
    "fund": "pnpm --filter @draw/scripts fund",
    "probe": "pnpm --filter @draw/scripts probe"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
