{
  "name": "draw",
  "version": "0.1.0",
  "private": true,
  "description": "Spend against what you own. Portfolio-backed payments on Solana.",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @draw/web dev",
    "shop": "pnpm --filter @draw/store dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "chain": "pnpm --filter @draw/scripts chain",
    "reset": "pnpm --filter @draw/scripts reset",
    "refresh": "pnpm --filter @draw/scripts refresh",
    "fund": "pnpm --filter @draw/scripts fund",
    "probe": "pnpm --filter @draw/scripts probe",
    "keygen": "pnpm --filter @draw/scripts keygen",
    "portfolio": "pnpm --filter @draw/scripts exec tsx src/portfolio.ts",
    "e2e-webhook": "pnpm --filter @draw/scripts exec tsx src/e2e-webhook.ts",
    "e2e-wallet": "pnpm --filter @draw/scripts exec tsx src/e2e-wallet.ts",
    "check": "pnpm --filter @draw/scripts exec tsx src/fund.ts 4D939xuRkkNst6KGTArf1bQWfvvQL2Ec5hrJGTxrbLPc && pnpm --filter @draw/scripts exec tsx src/e2e-webhook.ts 4ttyahDAQY3CmqdQrmPHaaRQnrJKtXEAJmaQp4hH21VTbrsoYZEkPJBwDL1pyzLTeezuHbZ8VBbMo6fWN2oUEDH4"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
